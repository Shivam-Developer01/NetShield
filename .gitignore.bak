# Data Files & Datasets (Keep structure, ignore raw/processed files)
data/raw/*
!data/raw/README.md
data/processed/*
!data/processed/README.md
data/external/*
!data/external/README.md

# ML Models & Binary Artifacts (Ignore binary files, keep directory READMEs)
artifacts/models/*.joblib
artifacts/models/*.pkl
artifacts/models/*.onnx
artifacts/models/*.h5
!artifacts/models/README.md
artifacts/preprocessors/*.joblib
!artifacts/preprocessors/README.md
artifacts/features/*.joblib
artifacts/features/*.json
!artifacts/features/README.md
artifacts/encoders/*.joblib
!artifacts/encoders/README.md
artifacts/metadata/*.json
!artifacts/metadata/README.md

