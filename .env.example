# NetShield Production Stack Environment Template

# MongoDB Credentials & URI
MONGO_INITDB_ROOT_USERNAME=netshield_admin
MONGO_INITDB_ROOT_PASSWORD=SuperSecretMongoPassword2026!
MONGODB_URI=mongodb://netshield_admin:SuperSecretMongoPassword2026!@mongodb:27017/netshield_db?authSource=admin

# Node.js Backend Microservice
PORT=5000
NODE_ENV=production
LOG_LEVEL=info
JWT_SECRET=netshield_production_jwt_secret_key_change_me_2026
JWT_EXPIRES_IN=1h
COOKIE_NAME=netshield_token
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000

# ML Microservice Target
ML_SERVICE_URL=http://ml-service:8000
ML_SERVICE_TIMEOUT_MS=10000

# Rate Limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Admin User Seeding
ADMIN_EMAIL=admin@netshield.local
ADMIN_PASSWORD=AdminSecurePassword123!
ADMIN_USERNAME=sysadmin

# Gmail
SMTP_HOST=[YOUR SMPT HOST]
SMTP_PORT=[YOUR SMTP PORT]
SMTP_SECURE=[YOUR SMTP SECURE]
SMTP_USER=[YOUR SMTP USER]
SMTP_PASS=[YOUR SMTP PASS]
SMTP_FROM=[YOUR SMTP FROM]
