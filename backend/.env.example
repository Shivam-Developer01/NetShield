# NetShield Backend Configuration

PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/netshield_db

# FastAPI ML Service Endpoint
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TIMEOUT_MS=10000

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication & JWT Configuration
JWT_SECRET=netshield_super_secret_jwt_key_phase11_dev_2026
JWT_EXPIRES_IN=1h
COOKIE_NAME=netshield_token
SENSOR_SERVICE_TOKEN=netshield_sensor_internal_service_token_phase20_11_secure

# Authentication Rate Limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Admin Seeding Credentials (development default)
ADMIN_EMAIL=admin@netshield.local
ADMIN_PASSWORD=AdminSecurePassword123!
ADMIN_USERNAME=sysadmin

# SMTP Email Notification Configuration (Gmail or Custom SMTP Provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_alert_sender@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
SMTP_FROM=your_alert_sender@gmail.com
